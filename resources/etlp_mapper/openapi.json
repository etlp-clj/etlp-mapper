{
  "openapi": "3.0.3",
  "info": {
    "title": "ETLP Mapper Service",
    "description": "Mapping service for creating and applying Jute-based data transformation templates. Supports HL7v2 parsing, mapping CRUD with version history, and template testing.",
    "version": "0.1.0"
  },
  "servers": [
    {"url": "http://localhost:3000", "description": "Local development"}
  ],
  "security": [{"bearerAuth": []}],
  "paths": {
    "/": {
      "get": {
        "summary": "Health check",
        "operationId": "getIndex",
        "responses": {
          "200": {
            "description": "Service is running",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {"type": "string", "example": "I'm Clojure"}
                  }
                }
              }
            }
          }
        }
      }
    },
    "/whoami": {
      "get": {
        "summary": "Get authenticated user info",
        "operationId": "getWhoami",
        "responses": {
          "200": {
            "description": "Current user identity",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/WhoamiResponse"}
              }
            }
          },
          "401": {"$ref": "#/components/responses/Unauthorized"}
        }
      }
    },
    "/mappings": {
      "get": {
        "summary": "List all mappings for the authenticated org",
        "operationId": "listMappings",
        "responses": {
          "200": {
            "description": "Array of mappings",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {"$ref": "#/components/schemas/Mapping"}
                }
              }
            }
          },
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "403": {"$ref": "#/components/responses/Forbidden"}
        }
      },
      "post": {
        "summary": "Create a new mapping",
        "operationId": "createMapping",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {"$ref": "#/components/schemas/CreateMappingRequest"}
            }
          }
        },
        "responses": {
          "201": {
            "description": "Mapping created",
            "headers": {
              "Location": {
                "description": "URI of the created mapping",
                "schema": {"type": "string", "example": "mappings/123"}
              }
            },
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/CreateMappingResponse"}
              }
            }
          },
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "403": {"$ref": "#/components/responses/Forbidden"}
        }
      }
    },
    "/mappings/{id}": {
      "parameters": [{"$ref": "#/components/parameters/MappingId"}],
      "get": {
        "summary": "Get a mapping by ID",
        "operationId": "getMapping",
        "responses": {
          "200": {
            "description": "Mapping found",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/Mapping"}
              }
            }
          },
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "404": {"description": "Mapping not found"}
        }
      },
      "put": {
        "summary": "Update a mapping's content",
        "operationId": "updateMapping",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {"$ref": "#/components/schemas/UpdateMappingRequest"}
            }
          }
        },
        "responses": {
          "200": {"description": "Mapping updated"},
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "404": {"description": "Mapping not found"}
        }
      },
      "delete": {
        "summary": "Delete a mapping",
        "operationId": "deleteMapping",
        "responses": {
          "200": {"description": "Mapping deleted"},
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "404": {"description": "Mapping not found"}
        }
      }
    },
    "/mappings/{id}/_history": {
      "parameters": [{"$ref": "#/components/parameters/MappingId"}],
      "get": {
        "summary": "Get version history for a mapping",
        "operationId": "getMappingHistory",
        "responses": {
          "200": {
            "description": "Array of historical versions",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {"$ref": "#/components/schemas/MappingHistoryEntry"}
                }
              }
            }
          },
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "404": {"description": "Mapping not found"}
        }
      }
    },
    "/mappings/{id}/_history/{version}": {
      "parameters": [
        {"$ref": "#/components/parameters/MappingId"},
        {"$ref": "#/components/parameters/VersionId"}
      ],
      "get": {
        "summary": "Get a specific historical version of a mapping",
        "operationId": "getMappingHistoryVersion",
        "responses": {
          "200": {
            "description": "Historical version",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/MappingHistoryEntry"}
              }
            }
          },
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "404": {"description": "Version not found"}
        }
      }
    },
    "/mappings/{id}/apply": {
      "parameters": [{"$ref": "#/components/parameters/MappingId"}],
      "post": {
        "summary": "Apply a mapping template to input data",
        "operationId": "applyMapping",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {"$ref": "#/components/schemas/ApplyMappingRequest"}
            }
          }
        },
        "responses": {
          "200": {
            "description": "Transformation result",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/ApplyMappingResponse"}
              }
            }
          },
          "400": {
            "description": "Transformation error",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/ErrorResponse"}
              }
            }
          },
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "404": {"description": "Mapping not found"}
        }
      }
    },
    "/mappings/test": {
      "post": {
        "summary": "Test a mapping template without persisting",
        "operationId": "testMapping",
        "requestBody": {
          "required": true,
          "description": "Raw YAML body containing template and scope",
          "content": {
            "application/x-yaml": {
              "schema": {"type": "string"},
              "example": "template: |\n  name: {{ first_name }}\nscope:\n  first_name: John\n"
            }
          }
        },
        "responses": {
          "200": {
            "description": "Compiled template output",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/TestMappingResponse"}
              }
            }
          },
          "400": {
            "description": "Template compilation error",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/ErrorResponse"}
              }
            }
          },
          "401": {"$ref": "#/components/responses/Unauthorized"}
        }
      }
    },
    "/openapi.json": {
      "get": {
        "summary": "OpenAPI schema",
        "operationId": "getOpenApiSchema",
        "security": [],
        "responses": {
          "200": {
            "description": "This OpenAPI specification",
            "content": {
              "application/json": {
                "schema": {"type": "object"}
              }
            }
          }
        }
      }
    },
    "/jute-dsl-spec.json": {
      "get": {
        "summary": "Jute DSL specification for LLM copilot consumption",
        "operationId": "getJuteDslSpec",
        "security": [],
        "responses": {
          "200": {
            "description": "Comprehensive Jute DSL reference including directives, functions, operators, expression syntax, and examples",
            "content": {
              "application/json": {
                "schema": {"type": "object"}
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "OIDC JWT token from Keycloak. Must contain org_id claim."
      }
    },
    "parameters": {
      "MappingId": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {"type": "integer"},
        "description": "Mapping ID"
      },
      "VersionId": {
        "name": "version",
        "in": "path",
        "required": true,
        "schema": {"type": "string"},
        "description": "Transaction ID (txnid) from history"
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "Missing or invalid JWT token",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "error": {"type": "string", "example": "Unauthorized"}
              }
            }
          }
        }
      },
      "Forbidden": {
        "description": "Missing org_id in token claims",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "error": {"type": "string", "example": "Forbidden: organization context required"}
              }
            }
          }
        }
      }
    },
    "schemas": {
      "WhoamiResponse": {
        "type": "object",
        "properties": {
          "org_id": {"type": "string", "description": "Organization ID from token"},
          "sub": {"type": "string", "description": "Subject / user ID"},
          "email": {"type": "string", "format": "email"},
          "exp": {"type": "integer", "description": "Token expiration (unix timestamp)"},
          "roles": {
            "type": "array",
            "items": {"type": "string"},
            "description": "User roles"
          }
        }
      },
      "MappingContent": {
        "type": "object",
        "description": "JSONB mapping definition, typically contains a 'yaml' key with the Jute template",
        "properties": {
          "yaml": {"type": "string", "description": "YAML-encoded Jute template"}
        },
        "additionalProperties": true
      },
      "Mapping": {
        "type": "object",
        "properties": {
          "id": {"type": "integer"},
          "title": {"type": "string"},
          "content": {"$ref": "#/components/schemas/MappingContent"},
          "org_id": {"type": "string"},
          "created_at": {"type": "string", "format": "date-time"},
          "updated_at": {"type": "string", "format": "date-time"},
          "href": {"type": "string", "example": "/mappings/123"}
        }
      },
      "MappingHistoryEntry": {
        "type": "object",
        "properties": {
          "title": {"type": "string"},
          "content": {"$ref": "#/components/schemas/MappingContent"},
          "created_at": {"type": "string", "format": "date-time"},
          "updated_at": {"type": "string", "format": "date-time"},
          "txnid": {"type": "string", "description": "PostgreSQL transaction ID"},
          "href": {"type": "string", "example": "/mappings/123/_history/456"}
        }
      },
      "CreateMappingRequest": {
        "type": "object",
        "required": ["title", "content"],
        "properties": {
          "title": {"type": "string", "description": "Human-readable mapping name"},
          "content": {"$ref": "#/components/schemas/MappingContent"}
        }
      },
      "CreateMappingResponse": {
        "type": "object",
        "properties": {
          "id": {"type": "integer"},
          "href": {"type": "string", "example": "/mappings/123"}
        }
      },
      "UpdateMappingRequest": {
        "type": "object",
        "required": ["content"],
        "properties": {
          "content": {"$ref": "#/components/schemas/MappingContent"}
        }
      },
      "ApplyMappingRequest": {
        "type": "object",
        "required": ["data"],
        "properties": {
          "data": {
            "type": "object",
            "description": "Input data to transform using the mapping template",
            "additionalProperties": true
          }
        }
      },
      "ApplyMappingResponse": {
        "type": "object",
        "properties": {
          "result": {
            "description": "Transformed output from the Jute template"
          },
          "org/id": {"type": "string"}
        }
      },
      "TestMappingResponse": {
        "type": "object",
        "properties": {
          "request": {
            "description": "Compiled template output"
          },
          "org/id": {"type": "string"}
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {"type": "string"}
        }
      }
    }
  }
}
